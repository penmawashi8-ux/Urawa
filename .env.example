# このファイルを .env にコピーして、自分のアカウント情報を書いてください。
# .env は .gitignore 済みなので Git には入りません。

URAWA_EMAIL=your-login-id@example.com
URAWA_PASSWORD=your-password

# --- 以下は任意（通常は変更不要） ---

# ログインページ / ログイン後に開くページ
# URAWA_LOGIN_URL=https://urawakeiba-funclub.com/signin/
# URAWA_HOME_URL=https://urawakeiba-funclub.com/

# 自動検出がうまく動かない場合だけ、CSS セレクタを指定して上書きする
# （カンマ区切りで複数指定可。npm run inspect の出力を参考に）
# URAWA_USER_SELECTOR=input[name="log"]
# URAWA_PASS_SELECTOR=input[name="pwd"]
# URAWA_SUBMIT_SELECTOR=input[type="submit"]

# 失敗時に通知する Webhook（Slack / Discord 互換の JSON を POST）
# URAWA_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# 動作確認用: ブラウザを表示して実行したいとき HEADFUL=1
# HEADFUL=1

# Playwright 同梱の Chromium ではなく、既存の Chrome/Chromium を使いたいときだけ指定
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# リトライ回数 / タイムアウト(ms)
# URAWA_RETRIES=3
# URAWA_TIMEOUT_MS=30000
